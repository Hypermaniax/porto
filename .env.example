# ============================================================
# TEMPLATE environment frontend (porto).
# Salin file ini menjadi ".env.local" lalu isi nilainya:
#     cp .env.example .env.local
#
# CATATAN: file ".env.local" JANGAN di-commit (sudah di-ignore git).
# File ".env.example" ini AMAN di-commit karena tanpa nilai rahasia.
#
# Semua variabel HARUS diawali "VITE_" supaya terbaca di browser.
# ============================================================

# Alamat backend Go (api-porto).
VITE_API_URL=http://localhost:3000

# --- Cloudinary (upload gambar di /admin) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
